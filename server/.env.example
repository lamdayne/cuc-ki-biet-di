PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Configuration (Server Service Role - Never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication
# Generate using: npm run hash-pin 123456
ADMIN_PIN_HASH=$2a$10$exampleHashGeneratedByBcrypt
JWT_SECRET=super_secret_cookie_bakery_jwt_key_2026_change_in_production
